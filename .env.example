# 飞书应用凭证
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 机器人 open_id：不填会自动调用 /open-apis/bot/v3/info/ 拉取；拉取失败时群聊新会话 fail-closed
FEISHU_BOT_OPEN_ID=
# 群聊新会话是否必须 @机器人（线程内回复免 @）
FEISHU_REQUIRE_MENTION=true

# 诊断引擎：fake（离线确定性）| pi（真实模型）
TD_ENGINE=fake
TD_PROVIDER=deepseek
TD_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# 存储与调度
TD_DB_PATH=./data/ticket-doctor.sqlite
# 会话日志（JSONL）目录：逐次消息/工具/用量/压缩事件的真相源
TD_SESSION_DIR=./data/sessions
TD_WORKER_COUNT=4
TD_LEASE_MS=60000
TD_HEARTBEAT_MS=10000
TD_MAX_ATTEMPTS=2
TD_DIAGNOSIS_TIMEOUT_MS=180000
TD_MAX_RESULT_CHARS=4000
TD_MAX_TOOL_RESULT_CHARS=8000
# 时间窗：找到“发生时间”时的窗口；未找到时按上报时间回溯的兜底窗口
TD_DEFAULT_TIME_WINDOW_MS=21600000
TD_FALLBACK_TIME_WINDOW_MS=86400000
# pi 上下文压缩兜底（默认开启）；接近上下文窗口时自动总结旧内容
TD_COMPACTION_ENABLED=true
TD_RUN_WORKERS_IN_GATEWAY=true

# 材料源权限范围
TD_LOG_DIR=./fixtures/samples
TD_REPOS=app:<项目根>
TD_ALLOWED_SERVICES=
TD_ALLOWED_REPOS=app
