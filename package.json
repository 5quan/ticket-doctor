{
  "name": "ticket-doctor",
  "version": "0.3.1",
  "private": true,
  "description": "飞书 Bug 消息自动预检 Agent：只读日志与源码诊断，同一线程多轮追问",
  "type": "module",
  "scripts": {
    "demo": "node --experimental-strip-types src/entrypoints/demo.ts",
    "predemo": "node scripts/init-demo-repo.mjs",
    "eval": "node --experimental-strip-types src/evals/cli.ts",
    "preeval": "node scripts/init-eval-fixture.mjs",
    "eval:v2": "node --experimental-strip-types src/evals/v2/cli.ts",
    "gateway": "node --experimental-strip-types src/entrypoints/gateway.ts",
    "host": "node --experimental-strip-types src/entrypoints/host.ts",
    "worker": "node --experimental-strip-types src/entrypoints/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "docs:check": "node scripts/check-docs.mjs",
    "test:go": "cd adapters/go && go test ./...",
    "pretest": "node scripts/init-demo-repo.mjs && node scripts/init-eval-fixture.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@larksuiteoapi/node-sdk": "^1.74.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
