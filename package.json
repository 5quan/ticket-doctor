{
  "name": "ticket-doctor",
  "version": "0.3.1",
  "private": true,
  "description": "飞书 Bug 消息自动预检 Agent：只读日志与源码诊断，同一线程多轮追问",
  "type": "module",
  "scripts": {
    "demo": "node --experimental-strip-types src/entrypoints/demo.ts",
    "predemo": "node scripts/init-demo-repo.mjs",
    "gateway": "node --experimental-strip-types src/entrypoints/gateway.ts",
    "host": "node --experimental-strip-types src/entrypoints/host.ts",
    "worker": "node --experimental-strip-types src/entrypoints/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "eval": "node --experimental-strip-types scripts/eval.ts",
    "eval:compare": "node --experimental-strip-types scripts/eval-compare.ts",
    "eval:review": "node --experimental-strip-types scripts/eval-review.ts",
    "eval:lf:preflight": "node --experimental-strip-types scripts/eval-lf.ts preflight",
    "eval:lf:seed": "node --experimental-strip-types scripts/eval-lf.ts seed",
    "eval:lf:run": "node --experimental-strip-types scripts/eval-lf.ts run",
    "eval:lf:verify": "node --experimental-strip-types scripts/eval-lf.ts verify",
    "eval:lf:review": "node --experimental-strip-types scripts/eval-lf.ts review",
    "evolve:materials:verify": "node --experimental-strip-types scripts/evolve-materials.ts verify",
    "evolve:materials:convert": "node --experimental-strip-types scripts/evolve-materials.ts convert",
    "docs:check": "node scripts/check-docs.mjs",
    "test:go": "cd adapters/go && go test ./...",
    "pretest": "node scripts/init-demo-repo.mjs && node scripts/init-eval-fixture.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@langfuse/client": "5.13.1",
    "@langfuse/core": "5.13.1",
    "@langfuse/otel": "5.13.1",
    "@langfuse/tracing": "5.13.1",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "2.0.1",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.207.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
