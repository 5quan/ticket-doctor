# 复制为 .env 后逐项生成替换。生成命令见各注释。
NEXTAUTH_SECRET=           # openssl rand -base64 32
SALT=                      # openssl rand -base64 32
ENCRYPTION_KEY=            # openssl rand -hex 32
NEXTAUTH_URL=              # 浏览器实际访问地址，如 http://<服务器入口IP>:3001
CLICKHOUSE_PASSWORD=       # openssl rand -hex 16
REDIS_AUTH=                # openssl rand -hex 16
POSTGRES_PASSWORD=         # openssl rand -hex 16
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD 同值>@postgres:5432/postgres
MINIO_ROOT_PASSWORD=       # openssl rand -hex 16
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=   # 与 MINIO_ROOT_PASSWORD 同值
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=   # 与 MINIO_ROOT_PASSWORD 同值
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=   # 与 MINIO_ROOT_PASSWORD 同值
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=            # http://<服务器入口IP>:19090
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=   # http://<服务器入口IP>:19090
LANGFUSE_INIT_ORG_NAME=ticket-doctor
LANGFUSE_INIT_PROJECT_NAME=ticket-doctor
LANGFUSE_INIT_USER_NAME=ticket-doctor
LANGFUSE_INIT_USER_EMAIL=admin@ticket-doctor.local
LANGFUSE_INIT_USER_PASSWORD=                  # 强密码，仅首次空库初始化生效
