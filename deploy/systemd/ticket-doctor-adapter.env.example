# ticket-doctor Go 接入适配器运行环境（复制为 /etc/ticket-doctor-adapter.env，chmod 600）。
# 这是现网 systemd 部署用的环境文件；值按新服务器/新飞书应用填写，勿提交本文件。
ADAPTER_MODE=ws
ADAPTER_ADDR=0.0.0.0:3002
HOST_API_BASE=http://127.0.0.1:3000/api/agent
ADAPTER_PLATFORMS=feishu
LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=
LARK_BOT_OPEN_ID=
LARK_LOG_LEVEL=info
ADAPTER_POLL_INTERVAL_MS=1000
